# ==============================================================================
# PLAYNEX BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Connection (Default: SQLite, easily switch to PostgreSQL or MySQL)
DATABASE_URL=sqlite:///./playlist_manager.db
# DATABASE_URL=postgresql://user:password@localhost:5432/playnex_db
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/playnex_db

# Security & JWT
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production-playnex-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# YouTube Data API v3 (Optional: Application has built-in high-speed scraper fallback)
YOUTUBE_API_KEY=

# ==============================================================================
# EMAIL SMTP CONFIGURATION (Required for Production Email OTP Delivery)
# ==============================================================================
# Example with Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_TLS=True
# SMTP_SSL=False

# Example with Resend / SendGrid / Brevo:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_123456789
# SMTP_TLS=True

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
SMTP_SSL=False
EMAILS_FROM_EMAIL=noreply@playnex.com
EMAILS_FROM_NAME=Playnex Platform
